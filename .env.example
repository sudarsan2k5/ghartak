# Local development only. Copy to .env and keep .env uncommitted.
# Host ports avoid the Homebrew PostgreSQL 15 (5432) and Redis (6379)
# already listening on this machine. Containers still use 5432 and 6379 internally.

POSTGRES_USER=ghartak
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ghartak
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ghartak:change-me-local-only@127.0.0.1:5433/ghartak

REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6380
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6380

# API. In development, DATABASE_URL must use port 5433 and REDIS_URL must use port 6380.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Initial administrator. Do not commit a password.
# pnpm --filter @ghartak/api admin:create
# ADMIN_NAME, ADMIN_EMAIL, and ADMIN_PHONE are required.
# Pass the password as ADMIN_PASSWORD for that command only, then unset it.
# ADMIN_SESSION_TTL_SECONDS=43200
# ADMIN_LOGIN_LIMIT=8
# ADMIN_LOGIN_WINDOW_SECONDS=900
# Comma-separated browser origins for the admin dashboard, used in addition to the API's own origin.
# Local dashboard: http://localhost:3001. Production example: https://admin.example
# ADMIN_TRUSTED_ORIGINS=http://localhost:3001

# Guest order tracking. HMAC key used to recover a capability token on idempotent checkout retry.
# Store only the SHA-256 hash of the token. Do not log the secret or raw token.
# ORDER_TRACKING_SECRET=
# ORDER_STATUS_LIMIT=30
# ORDER_STATUS_WINDOW_SECONDS=60

# Admin dashboard. Copy NEXT_PUBLIC_API_BASE_URL into apps/admin/.env.local.
# Use localhost on both sides. Do not point the dashboard at 127.0.0.1 while opening it on localhost.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Cloudflare R2. Leave every value unset until a bucket exists.
# All five must be set together. The public base is an https origin with no path or credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://images.example.com

# Customer app only. Expo reads apps/mobile/.env, not this file.
# These defaults are also coded in the app until address selection exists.
# EXPO_PUBLIC_PLACEHOLDER_ADDRESS_LABEL=Home
# EXPO_PUBLIC_PLACEHOLDER_ADDRESS_LINE=Add your address
