# Browser origin of the API. No path, user, or password.
# Local development can leave this unset. The app then uses http://localhost:3000.
# Production must set the public API origin. Do not use a loopback address there.
# Use localhost for both apps in local development. localhost and 127.0.0.1 are different sites,
# and the session cookie will not be sent across them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
