{
  "name": "@ghartak/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Ghartak admin dashboard.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3001",
    "build": "NODE_ENV=production next build",
