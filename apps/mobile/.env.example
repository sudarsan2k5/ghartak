# Copy to apps/mobile/.env. Expo reads this directory, not the repo root.
# Leave the address unset to use the in-app defaults.

EXPO_PUBLIC_PLACEHOLDER_ADDRESS_LABEL=Home
EXPO_PUBLIC_PLACEHOLDER_ADDRESS_LINE=Add your address

# API origin. Leave unset in local development.
# Android emulator: http://10.0.2.2:3000
# iOS simulator and web: http://127.0.0.1:3000
# A physical device needs your computer's LAN address.
# Production must set this explicitly. Do not put credentials in the URL.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# EXPO_PUBLIC_APP_ENV=development

# Optional origin for catalogue delivery paths such as /catalog/toor-dal/primary.jpg.
# Leave unset until image hosting exists. The app then shows a photo fallback.
# EXPO_PUBLIC_IMAGE_BASE_URL=https://images.example.com
