{
  "name": "ghartak",
  "version": "0.0.0",
  "private": true,
  "description": "GharTak grocery delivery platform",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev": "pnpm --filter @ghartak/api dev",
    "start": "pnpm --filter @ghartak/api start",
    "db:generate": "pnpm --filter @ghartak/database db:generate",
    "db:migrate": "pnpm --filter @ghartak/database db:migrate",
    "db:seed": "pnpm --filter @ghartak/database db:seed",
    "db:verify": "pnpm --filter @ghartak/database db:verify",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "infra:ps": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml logs -f"
  }
}
